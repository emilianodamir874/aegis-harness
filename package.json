{
    "name":  "aegis-web-tools",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "Herramientas de la web de aegis (probes node/playwright contra el cliente web)",
    "scripts":  {
                    "pop-clamp-check":  "node tools/usage-pop-clamp-check.mjs",
                    "css-check":  "node tools/css-check.mjs",
                    "code-fence-check":  "node tools/code-fence-check.mjs",
                    "tool-states-check":  "node tools/tool-states-check.mjs",
                    "typecheck":  "tsc -p tsconfig.server.json \u0026\u0026 tsc -p tsconfig.client.json \u0026\u0026 tsc -p tsconfig.tests.json",
                    "build":  "npm run typecheck \u0026\u0026 node tools/build-typescript.mjs",
                    "test":  "npm run build \u0026\u0026 node dist-ts/tests/run.mjs",                },
    "devDependencies":  {
                            "@types/node":  "^22.18.6",
                            "esbuild":  "^0.28.2",
                            "playwright":  "^1.64.1",
                            "typescript":  "^5.9.3"
                        },
    "dependencies":  {
                         "msedge-tts":  "^2.1.0"
                     }
}

