# El repositorio contiene solo codigo y operaciones del harness.
/*
!/.gitignore
!/README.md
!/src/
!/web/
!/core/
!/docs/

# Runtime, binarios y scripts locales de operacion no incorporados.
/core/*
!/core/ops/
/core/ops/*
!/core/ops/.gitattributes
!/core/ops/README.md
!/core/ops/_pointer.ps1
!/core/ops/build.ps1
!/core/ops/build-and-promote.ps1
!/core/ops/swap.ps1
!/core/ops/check-consistency.ps1
!/core/ops/health-gate.ps1
!/core/ops/canary.yaml
!/core/ops/snapshot-good.ps1
!/core/ops/selfheal.ps1
!/core/ops/install-selfheal.ps1
!/core/ops/backup-local.ps1
!/core/ops/jobs.ps1
!/core/ops/prune-artifacts.ps1
!/core/ops/prune-binaries.ps1
!/core/ops/prune-logs.ps1
!/core/ops/prune-sessions.ps1
!/core/ops/wipe-sessions-store.ps1
!/core/ops/gate.ps1
!/core/ops/wip-attribution.ps1

# Documentacion vigente del harness; el resto son instantaneas y proyectos aparte.
/docs/*
!/docs/monorepo.md
!/docs/aegis-harness-estudio.md
!/docs/harness-backend/

# Checkouts previos: se archivan fuera de la raiz tras verificar la importacion.
/src/.git/
/web/.git/
/core/ops/.git/
